
erDiagram
    MEMBERS {
        INT member_id PK
        VARCHAR first_name
        VARCHAR last_name
        VARCHAR phone UK
        VARCHAR email UK
        ENUM gender
        DATE join_date
    }

    PLANS {
        INT plan_id PK
        VARCHAR plan_name UK
        INT duration_months
        DECIMAL price
        VARCHAR description
    }

    TRAINERS {
        INT trainer_id PK
        VARCHAR trainer_name
        VARCHAR specialization
        VARCHAR phone UK
        DECIMAL salary
        DATE hire_date
    }

    MEMBERSHIPS {
        INT membership_id PK
        INT member_id FK
        INT plan_id FK
        INT trainer_id FK
        DATE start_date
        DATE end_date
        ENUM status
    }

    PAYMENTS {
        INT payment_id PK
        INT membership_id FK
        DECIMAL amount
        DATETIME payment_date
        ENUM payment_method
        ENUM payment_status
    }

    ATTENDANCE {
        INT attendance_id PK
        INT member_id FK
        DATETIME check_in_time
    }

    MEMBERSHIP_LOG {
        INT log_id PK
        INT membership_id
        INT member_id
        VARCHAR action
        DATETIME log_date
    }

    MEMBERS ||--o{ MEMBERSHIPS : has
    PLANS ||--o{ MEMBERSHIPS : selected_for
    TRAINERS ||--o{ MEMBERSHIPS : assigned_to
    MEMBERSHIPS ||--o{ PAYMENTS : receives
    MEMBERS ||--o{ ATTENDANCE : records
